# Dependencies
node_modules/

# Dogfood artifacts (praxis scan . self-report)
praxis-report.html

# Archive (old reports, samples, generated artifacts)
archive/

# Claude Code local config (local-only, never published)
CLAUDE.md
.claude/

# Local-only working docs. The public repo describes the tool — README, docs/,
# .github/CONTRIBUTING.md. These two are working notes and are not published.
AGENTS.md
CHANGELOG.md

# Runtime state (scan context, undo/fix history, caches)
.praxis/
*.fixes.jsonl
~/.praxis/

# Test fixtures
fixtures/
showcase-target/
showcase-evidence/

# Local lab journal
SHOWCASE-LAB-LOG.md

# Internal planning/assessment docs (not for public release)
docs/internal/

# npm pack artifacts
*.tgz

# Stray agent/editor session transcripts dropped in the working tree.
# Untracked tooling state — never part of the project, and it would otherwise be
# scanned (a session log reads as base64 payloads / agent-transcript findings).
*.mdexit

# Secrets — never commit real API keys.
# .env holds your live keys (ignored); .env.example is the tracked template.
.env
.env.local
.env.*.local
!.env.example
