# =============================================================================
# Praxis LLM configuration — OpenAI-compatible
# =============================================================================
# This file is gitignored. NEVER commit real keys.
# Put your real key below — Praxis loads this file automatically at startup.
#
# Works with OpenAI directly OR any OpenAI-compatible gateway
# (OpenRouter, Groq, Together, DeepSeek, LM Studio, Azure, LiteLLM, vLLM...).
# For a gateway: set OPENAI_BASE_URL to its /chat/completions endpoint.

# --- API key (required for cloud LLM features) ------------------------------
OPENAI_API_KEY=sk-replace-me-with-your-real-key

# --- Endpoint (model URL) ----------------------------------------------------
# OpenAI direct:
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# OpenRouter example:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# Local server example (LM Studio / vLLM / LiteLLM):
# OPENAI_BASE_URL=http://localhost:1234/v1/chat/completions

# --- Model name ---------------------------------------------------------------
PRAXIS_LLM_MODEL=gpt-5.4-mini

# --- Reasoning effort (extended thinking) -------------------------------------
# low | medium | high  — sent as reasoning_effort for models that support it.
# Leave empty to disable extended thinking.
PRAXIS_LLM_REASONING=high

# =============================================================================
# Optional: other providers (auto-detected if set; first match wins)
# =============================================================================
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# XAI_API_KEY=
